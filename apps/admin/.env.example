# Copy to .env.local and adjust.
NODE_ENV=development
# 3001 so `next dev` here can run alongside the storefront (also 3000).
# The container port is set by docker-compose (PORT=3000), not this file.
PORT=3001

# Base URL of the api-gateway, used by this app's server-side /api route
# handlers. Deliberately NOT a NEXT_PUBLIC_ var: the browser never calls the
# gateway directly, so this URL has no business in the client bundle.
# In docker-compose this is http://api-gateway:4000.
API_GATEWAY_URL=http://localhost:4000

# Set to "true" only when the deployment terminates TLS. A Secure cookie is
# dropped over plain HTTP, which makes sign-in look like it worked and then
# bounce straight back to the login page.
SESSION_COOKIE_SECURE=false
