# Copy to .env.local and adjust.
NODE_ENV=development
PORT=3000

# Base URL the browser uses to reach the api-gateway.
# Behind nginx leave it EMPTY so the app calls its own origin ("/api/...").
# For `next dev` against a locally running gateway, use the gateway port (4000).
NEXT_PUBLIC_API_URL=

# Server-side base URL used by this app's own /api/* route handlers, which
# attach the httpOnly session token as a Bearer header (app/lib/gateway.ts).
# In Docker this must be the compose service name (http://api-gateway:4000);
# the browser-facing value above cannot be reused, because "/api" from inside
# the container would resolve to the storefront itself.
# Falls back to NEXT_PUBLIC_API_URL when unset, which suits local `next dev`.
API_GATEWAY_URL=
