# Copy to .env and adjust. Values here match docker-compose.yml.
NODE_ENV=development
PORT=3000

# Infrastructure
DATABASE_URL=postgresql://app:app@localhost:5432/app
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://app:app@localhost:5672

# Messaging: one shared fanout exchange. This service binds its own queue to it
# so it receives every order.created event.
MESSAGING_URL=amqp://app:app@localhost:5672
MESSAGING_EXCHANGE=orders.events
MESSAGING_QUEUE_DURABLE=true
MESSAGING_PREFETCH_COUNT=1
# This service's own queue on that exchange is 'catalog.order-events'.

# Seed demo products on boot. Defaults to true outside production.
SEED_DB=true
# Number of demo products to seed (10-100). The fixed demo products come first,
# then faker-generated ones fill the remainder.
SEED_PRODUCTS_COUNT=50