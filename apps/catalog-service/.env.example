# Copy to .env and adjust. Values here match docker-compose.yml.
NODE_ENV=development
PORT=3000

# Infrastructure
DATABASE_URL=postgresql://app:app@localhost:5432/app
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://app:app@localhost:5672

# Messaging / microservice transport. 'tcp' | 'rmq'
MESSAGING_TRANSPORT=rmq
MESSAGING_RETRY_ATTEMPTS=5
MESSAGING_RETRY_DELAY_MS=3000
# TCP transport options (used when MESSAGING_TRANSPORT=tcp)
MESSAGING_HOST=localhost
MESSAGING_PORT=4000
# RabbitMQ transport options (used when MESSAGING_TRANSPORT=rmq)
MESSAGING_URL=amqp://app:app@localhost:5672
# Private queue: reply channel for the commands this service serves.
MESSAGING_QUEUE=catalog.replies
MESSAGING_QUEUE_DURABLE=true
MESSAGING_PREFETCH_COUNT=1

# --- domain events (fanout) -------------------------------------------------
# Events go through ONE shared exchange; every subscriber binds its own queue
# to it. Publishing to a plain queue delivers to a single consumer only, so a
# second service would silently never receive the event.
#
# The event queue is not set from the environment on purpose: a service's
# event queue must differ from its private reply queue, and letting
# MESSAGING_QUEUE drive both collapsed the two roles onto one queue.
MESSAGING_EXCHANGE=orders.events
# This service's own queue on that exchange is 'catalog.order-events'.

# Seed demo products on boot. Defaults to true outside production.
SEED_DB=true