# Copy to .env and adjust. Values here match docker-compose.yml.
NODE_ENV=development
PORT=3000

# Infrastructure
DATABASE_URL=postgresql://app:app@localhost:5432/app
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://app:app@localhost:5672

# Auth. AUTH_JWT_SECRET signs the session tokens the api-gateway verifies, so
# the two services MUST use the same value. Required (>= 16 chars) in production.
AUTH_JWT_SECRET=dev-only-insecure-jwt-secret-change-me
# Session lifetime, in seconds (default 8 hours).
AUTH_TOKEN_TTL_SECONDS=28800

# The admin account created on first boot when SEED_DB is on. The password is
# hashed with Argon2id before storage and is required in production.
# Note: this seeds the account once — changing it later does not rotate the
# password of an account that already exists.
AUTH_ADMIN_EMAIL=admin@example.com
AUTH_ADMIN_PASSWORD=admin12345

# Seed reference data on boot (default: on outside production).
SEED_DB=true
