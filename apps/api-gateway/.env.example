# Copy to .env and adjust. Values here match docker-compose.yml.
NODE_ENV=development

# The gateway is the only publicly exposed HTTP service; it listens on 4000
# so it never collides with the internal services on 3000.
PORT=4000
# Global timeout applied to every proxied downstream request (ms).
REQUEST_TIMEOUT_MS=10000

# Downstream microservices (in-network names from docker-compose)
CATALOG_SERVICE_URL=http://catalog-service:3000
IDENTITY_SERVICE_URL=http://identity-service:3000
ORDERS_SERVICE_URL=http://orders-service:3000
NOTIFICATIONS_SERVICE_URL=http://notifications-service:3000

# HMAC secret for session tokens. The gateway only verifies them; identity-service
# signs them. The two values MUST match or every protected request will 401.
# Required (>= 16 chars) in production.
AUTH_JWT_SECRET=dev-only-insecure-jwt-secret-change-me
