# Copy to .env and adjust. Values here match docker-compose.yml.
NODE_ENV=development
PORT=3000

# MongoDB. The compose stack runs a single-node replica set.
#   docker:    mongodb://mongo:27017/cart?replicaSet=rs0
#   host-run:  mongodb://localhost:27017/cart?directConnection=true
MONGODB_URI=mongodb://localhost:27017/cart?directConnection=true
