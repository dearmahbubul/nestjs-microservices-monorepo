# Copy to .env and adjust as needed. docker compose reads it automatically.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# MongoDB: one server, one database per service (catalog, cart). No auth —
# dev-stack convenience, same as the broker credentials above.
MONGO_PORT=27017

RABBITMQ_USER=app
RABBITMQ_PASSWORD=app

# Host ports for the compose broker if 5672/15672 are already taken by another
# project on this machine (the services talk to rabbitmq:5672 internally and
# are unaffected).
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# Admin UI host ports (see docker-compose.yml).
ADMINER_PORT=8080
REDIS_COMMANDER_PORT=8081
