{
  "name": "@repo/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Fail-fast environment variable parsing shared by every service.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src/"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^24.0.0",
    "oxlint": "^1.58.0",
    "typescript": "^6.0.2"
  }
}
